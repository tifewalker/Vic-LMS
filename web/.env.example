# Web app (Render Static Site). Everything here is public: it is built into the browser bundle.
# Never put the Supabase service role key here.

# The API (Render Web Service)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase project: Settings > API (the anon/public key, not the service role key)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
