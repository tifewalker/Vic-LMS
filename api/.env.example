# API (Render Web Service). Never expose these to the web app.
PORT=4000
NODE_ENV=development

# Public URL of the web app. Used in email links and for CORS (comma-separate extra origins).
WEB_URL=http://localhost:3000

# Supabase project: Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Server only. Full database access, bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Email. EMAIL_PROVIDER: smtp (any SMTP host), resend, or console (printed here, nothing sent).
# Leave it empty locally: emails are printed to the console.
EMAIL_PROVIDER=
# SMTP: the dedicated sending mailbox on our own domain. Port 465 uses TLS; 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Resend, only when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# The From name stays the same on every email.
EMAIL_FROM="Crystal Entrepreneurship <noreply@example.com>"
# A mailbox someone actually reads. Replies go here.
EMAIL_REPLY_TO=
# Warm-up for a new domain: first sending day (YYYY-MM-DD). The daily cap ramps
# 50, 50, 100, 100, 250, 250, 500, 500, 1000, 1000 over days 1 to 10, then EMAIL_DAILY_LIMIT.
EMAIL_WARMUP_START=
EMAIL_DAILY_LIMIT=90
EMAIL_RATE_PER_MINUTE=20
# Used once by `pnpm seed:admin` to create the first super_admin.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
