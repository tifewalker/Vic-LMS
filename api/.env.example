# API (Render Web Service). Never expose these to the web app.
PORT=4000
NODE_ENV=development

# Public URL of the web app. Used in email links and for CORS (comma-separate extra origins).
WEB_URL=http://localhost:3000

# Supabase project: Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Server only. Full database access, bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Resend. Leave empty locally: email links are printed to the console instead.
RESEND_API_KEY=
# Must be on a domain verified in Resend to deliver to anyone other than your own Resend account.
EMAIL_FROM="Victory Entrepreneurship Centre <noreply@example.com>"
# Resend free plan: 100 emails a day. Keep headroom for password resets.
EMAIL_DAILY_LIMIT=90

# Used once by `pnpm seed:admin` to create the first super_admin.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
